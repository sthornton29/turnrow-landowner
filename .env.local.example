# Copy this file to .env.local and fill in the values.
# Set the same three variables in Vercel (Project Settings > Environment Variables).

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Mapbox: your public token (pk....)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.YOUR-MAPBOX-PUBLIC-TOKEN

# Anthropic API key for AI document extraction (server-side only; note there
# is deliberately NO NEXT_PUBLIC_ prefix so it never reaches the browser)
ANTHROPIC_API_KEY=sk-ant-YOUR-KEY

# --- Phase 6: tenant farm data connections (all server-side only) ---

# Base URL of the farm software's partner API (no trailing slash)
FARM_API_BASE_URL=https://YOUR-FARM-SOFTWARE-DOMAIN/api/partner/v1

# Encrypts farm API tokens at rest. Generate 64 hex characters with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FARM_API_ENCRYPTION_KEY=64-HEX-CHARACTERS

# Shared secret that authorizes the Vercel cron to call /api/farm/sync.
# Any long random string; Vercel sends it automatically once set.
CRON_SECRET=A-LONG-RANDOM-STRING

# Supabase service role key (Project Settings > API > service_role).
# Used ONLY by the cron sync, which runs without a signed-in user.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
